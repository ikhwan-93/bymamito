# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
!.env.example

# database (local sqlite from dev; production uses Vercel Postgres)
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite-journal

# user-uploaded images (runtime data, not source; production uses Vercel Blob)
public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers SDD scratch workspace (per-plan briefs/reports/diffs)
.superpowers/

# source menu screenshots (raw material, not site assets)
menu-images/

# editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
Thumbs.db
